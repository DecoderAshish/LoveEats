+
+<section class="le-section">
+  <div class="le-section__head">
+    <h2 class="le-section__title">Menu</h2>
+    <span class="le-section__link">Sticky category tabs (next)</span>
+  </div>
+  <div class="le-grid2" id="le_menu_grid"></div>
+</section>
+
+<script>
+  (() => {
+    const slug = <?= json_encode((string)$slug) ?>
+    const nameEl = document.getElementById('le_rest_name')
+    const metaEl = document.getElementById('le_rest_meta')
+    const ratingEl = document.getElementById('le_rest_rating')
+    const pickNameEl = document.getElementById('le_pick_name')
+    const pickMetaEl = document.getElementById('le_pick_meta')
+    const menuGrid = document.getElementById('le_menu_grid')
+
+    window.leApi('/api/v1/restaurants/slug/' + encodeURIComponent(slug)).then((res) => {
+      if (!res.ok) {
+        nameEl.textContent = 'Not found'
+        return
+      }
+      const data = res.data.data
+      const r = data.restaurant
+      const cuisines = (() => { try { return JSON.parse(r.cuisines || '[]') } catch { return [] } })()
+      nameEl.textContent = r.name
+      metaEl.textContent = cuisines.slice(0, 4).join(' · ')
+      ratingEl.textContent = '★ ' + Number(r.rating || 0).toFixed(1)
+
+      const items = data.menu.items || []
+      const pick = items[0]
+      if (pick) {
+        pickNameEl.textContent = pick.name
+        pickMetaEl.textContent = '₹' + Number(pick.base_price).toFixed(0) + ' · Add-ons available'
+        document.querySelector('[data-action="add-pick"]').dataset.foodId = pick.id
+      }
+
+      const cats = data.menu.categories || []
+      const byCat = new Map()
+      for (const it of items) {
+        const cid = it.food_category_id || 0
+        if (!byCat.has(cid)) byCat.set(cid, [])
+        byCat.get(cid).push(it)
+      }
+
+      menuGrid.innerHTML = cats.map((c) => {
+        const list = byCat.get(c.id) || []
+        if (!list.length) return ''
+        return `
+          <div class="le-card">
+            <div class="le-card__body">
+              <div class="le-badge">${c.name}</div>
+              <div style="margin-top:10px;display:grid;gap:10px">
+                ${list.slice(0, 6).map((it) => `
+                  <div style="display:flex;gap:10px;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:10px">
+                    <div>
+                      <div style="font-weight:880">${it.name}</div>
+                      <div class="le-muted" style="margin-top:2px;font-size:13px">₹${Number(it.base_price).toFixed(0)} · ${it.is_veg ? 'Veg' : 'Non-veg'}</div>
+                    </div>
+                    <button class="le-btn" type="button" style="padding:10px 12px" data-action="add-item" data-food-id="${it.id}">Add</button>
+                  </div>
+                `).join('')}
+              </div>
+            </div>
+          </div>
+        `
+      }).join('')
+    })
+
+    document.addEventListener('click', async (e) => {
+      const btn = e.target.closest('[data-action="add-item"],[data-action="add-pick"]')
+      if (!btn) return
+      const foodId = Number(btn.dataset.foodId || btn.dataset.foodId || btn.getAttribute('data-food-id'))
+      if (!foodId) return
+      const res = await window.leApi('/api/v1/cart/items', { method: 'POST', body: JSON.stringify({ food_item_id: foodId, quantity: 1 }) })
+      if (res.ok) {
+        btn.textContent = 'Added'
+        setTimeout(() => (btn.textContent = 'Add'), 900)
+      } else {
+        alert(res.data?.error?.message || 'Login required. Go to /login.')
+      }
+    })
+  })()
+</script>
