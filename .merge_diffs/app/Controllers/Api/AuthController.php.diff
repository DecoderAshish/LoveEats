+<?php
+declare(strict_types=1);
+
+namespace App\Controllers\Api;
+
+use App\Bootstrap\App;
+use App\Http\Request;
+use App\Support\ApiResponse;
+use App\Support\Auth;
+use App\Support\Database;
+use App\Repositories\UserRepository;
+use App\Repositories\SessionRepository;
+use App\Repositories\OtpRepository;
+use App\Repositories\WalletRepository;
+use App\Services\Auth\AuthService;
+use App\Services\Auth\JwtService;
+
+final class AuthController extends BaseApiController
+{
+    private function service(App $app): AuthService
+    {
+        $pdo = Database::pdo($app->config());
+        return new AuthService(
+            $pdo,
+            new JwtService((string)$app->config()->get('app.jwt_secret')),
+            new UserRepository($pdo),
+            new SessionRepository($pdo),
+            new OtpRepository($pdo),
+            new WalletRepository($pdo),
+        );
+    }
+
+    public function register(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $name = trim((string)($request->body['name'] ?? ''));
+        $email = trim((string)($request->body['email'] ?? ''));
+        $password = (string)($request->body['password'] ?? '');
+
+        if ($name === '' || $email === '' || $password === '') {
+            return ApiResponse::error('VALIDATION_ERROR', 'name, email, password are required', 422);
+        }
+        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
+            return ApiResponse::error('VALIDATION_ERROR', 'Invalid email', 422);
+        }
+        if (mb_strlen($password) < 8) {
+            return ApiResponse::error('VALIDATION_ERROR', 'Password must be at least 8 characters', 422);
+        }
+
+        try {
+            $result = $this->service($app)->registerEmail($name, $email, $password);
+            return ApiResponse::ok($result);
+        } catch (\Throwable $e) {
+            return ApiResponse::error('REGISTER_FAILED', $e->getMessage(), 400);
+        }
+    }
+
+    public function login(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $email = trim((string)($request->body['email'] ?? ''));
+        $password = (string)($request->body['password'] ?? '');
+        if ($email === '' || $password === '') {
+            return ApiResponse::error('VALIDATION_ERROR', 'email and password are required', 422);
+        }
+        try {
+            $result = $this->service($app)->loginEmail($email, $password);
+            return ApiResponse::ok($result);
+        } catch (\Throwable $e) {
+            return ApiResponse::error('LOGIN_FAILED', $e->getMessage(), 401);
+        }
+    }
+
+    public function otpRequest(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $phone = preg_replace('/\s+/', '', (string)($request->body['phone'] ?? ''));
+        if ($phone === null || $phone === '') {
+            return ApiResponse::error('VALIDATION_ERROR', 'phone is required', 422);
+        }
+        try {
+            $result = $this->service($app)->requestOtp($phone);
+            $app->logger()->info('OTP requested', ['phone' => $phone, 'otp_debug' => $result['otp_debug']]);
+            $env = (string)$app->config()->get('app.env');
+            if ($env !== 'local') {
+                unset($result['otp_debug']);
+            }
+            return ApiResponse::ok($result);
+        } catch (\Throwable $e) {
+            return ApiResponse::error('OTP_REQUEST_FAILED', $e->getMessage(), 400);
+        }
+    }
+
+    public function otpVerify(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $phone = preg_replace('/\s+/', '', (string)($request->body['phone'] ?? ''));
+        $otp = trim((string)($request->body['otp'] ?? ''));
+        if ($phone === null || $phone === '' || $otp === '') {
+            return ApiResponse::error('VALIDATION_ERROR', 'phone and otp are required', 422);
+        }
+        try {
+            $result = $this->service($app)->verifyOtp($phone, $otp);
+            return ApiResponse::ok($result);
+        } catch (\Throwable $e) {
+            return ApiResponse::error('OTP_VERIFY_FAILED', $e->getMessage(), 400);
+        }
+    }
+
+    public function forgotPassword(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $email = trim((string)($request->body['email'] ?? ''));
+        if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
+            return ApiResponse::error('VALIDATION_ERROR', 'Valid email is required', 422);
+        }
+        $result = $this->service($app)->createPasswordReset($email);
+        $app->logger()->info('Password reset requested', ['email' => $email, 'reset_token' => $result['reset_token']]);
+        $env = (string)$app->config()->get('app.env');
+        if ($env !== 'local') {
+            $result['reset_token'] = 'sent';
+        }
+        return ApiResponse::ok($result);
+    }
+
+    public function resetPassword(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $email = trim((string)($request->body['email'] ?? ''));
+        $token = trim((string)($request->body['token'] ?? ''));
+        $password = (string)($request->body['password'] ?? '');
+        if ($email === '' || $token === '' || $password === '') {
+            return ApiResponse::error('VALIDATION_ERROR', 'email, token, password are required', 422);
+        }
+        if (mb_strlen($password) < 8) {
+            return ApiResponse::error('VALIDATION_ERROR', 'Password must be at least 8 characters', 422);
+        }
+        try {
+            $this->service($app)->resetPassword($email, $token, $password);
+            return ApiResponse::ok(['status' => 'ok']);
+        } catch (\Throwable $e) {
+            return ApiResponse::error('RESET_FAILED', $e->getMessage(), 400);
+        }
+    }
+
+    public function logout(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $uid = Auth::userId();
+        $sid = Auth::sessionId();
+        if ($uid === null || $sid === null) {
+            return ApiResponse::ok(['status' => 'ok']);
+        }
+        $this->service($app)->revokeSession($sid, $uid);
+        return ApiResponse::ok(['status' => 'ok']);
+    }
+
+    public function me(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $uid = Auth::userId();
+        if ($uid === null) {
+            return ApiResponse::error('UNAUTHENTICATED', 'Authentication required', 401);
+        }
+        $pdo = Database::pdo($app->config());
+        $users = new UserRepository($pdo);
+        $user = $users->findById($uid);
+        return ApiResponse::ok(['user' => $user, 'role' => Auth::role()]);
+    }
+
+    public function sessions(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $uid = Auth::userId();
+        if ($uid === null) {
+            return ApiResponse::error('UNAUTHENTICATED', 'Authentication required', 401);
+        }
+        $sessions = $this->service($app)->listSessions($uid);
+        return ApiResponse::ok(['sessions' => $sessions]);
+    }
+
+    public function revokeSession(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $uid = Auth::userId();
+        if ($uid === null) {
+            return ApiResponse::error('UNAUTHENTICATED', 'Authentication required', 401);
+        }
+        $id = isset($params['id']) ? (int)$params['id'] : 0;
+        if ($id <= 0) {
+            return ApiResponse::error('VALIDATION_ERROR', 'Invalid session id', 422);
+        }
+        $this->service($app)->revokeSession($id, $uid);
+        return ApiResponse::ok(['status' => 'ok']);
+    }
+}
