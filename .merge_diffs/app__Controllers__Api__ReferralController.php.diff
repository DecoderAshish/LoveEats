+<?php
+declare(strict_types=1);
+
+namespace App\Controllers\Api;
+
+use App\Bootstrap\App;
+use App\Http\Request;
+use App\Support\ApiResponse;
+use App\Support\Auth;
+use App\Support\Database;
+
+final class ReferralController extends BaseApiController
+{
+    public function invite(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $uid = Auth::userId();
+        if ($uid === null) {
+            return ApiResponse::error('UNAUTHENTICATED', 'Authentication required', 401);
+        }
+        $pdo = Database::pdo($app->config());
+        $st = $pdo->prepare('SELECT referral_code FROM users WHERE id = ? LIMIT 1');
+        $st->execute([$uid]);
+        $code = (string)$st->fetchColumn();
+        $base = (string)$app->config()->get('app.base_url');
+        $link = rtrim($base, '/') . '/?ref=' . urlencode($code);
+        return ApiResponse::ok(['referral_code' => $code, 'share_link' => $link]);
+    }
+
+    public function dashboard(Request $request, App $app, array $params): \App\Http\Response
+    {
+        $uid = Auth::userId();
+        if ($uid === null) {
+            return ApiResponse::error('UNAUTHENTICATED', 'Authentication required', 401);
+        }
+        $pdo = Database::pdo($app->config());
+        $st = $pdo->prepare('SELECT referral_code FROM users WHERE id = ? LIMIT 1');
+        $st->execute([$uid]);
+        $code = (string)$st->fetchColumn();
+
+        $c1 = $pdo->prepare('SELECT COUNT(*) FROM referrals WHERE referrer_user_id = ?');
+        $c1->execute([$uid]);
+        $total = (int)$c1->fetchColumn();
+
+        $c2 = $pdo->prepare("SELECT COUNT(*) FROM referrals WHERE referrer_user_id = ? AND status = 'rewarded'");
+        $c2->execute([$uid]);
+        $rewarded = (int)$c2->fetchColumn();
+
+        return ApiResponse::ok([
+            'referral_code' => $code,
+            'stats' => [
+                'total' => $total,
+                'rewarded' => $rewarded,
+            ],
+        ]);
+    }
+}
