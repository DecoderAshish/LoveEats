diff --git a/public/assets/app.css b/public/assets/app.css
new file mode 100644
index 0000000..ce13f5f
--- /dev/null
+++ b/public/assets/app.css
@@ -0,0 +1,170 @@
+:root{
+  --bg: #fff9ef;
+  --surface: #ffffff;
+  --text: #171717;
+  --muted: rgba(23,23,23,.62);
+  --line: rgba(23,23,23,.12);
+  --shadow: 0 18px 40px rgba(0,0,0,.10);
+  --shadow-soft: 0 10px 28px rgba(0,0,0,.08);
+  --radius-lg: 22px;
+  --radius-md: 16px;
+  --radius-sm: 12px;
+  --yellow-1: #ffe36a;
+  --yellow-2: #ffcc3d;
+  --yellow-3: #ffb200;
+  --grad: radial-gradient(1200px 600px at 12% 8%, rgba(255,210,79,.55), rgba(255,255,255,0) 55%),
+          radial-gradient(900px 500px at 90% 18%, rgba(255,178,0,.35), rgba(255,255,255,0) 58%),
+          linear-gradient(180deg, #fff4d2, #fff9ef 38%, #fff9ef);
+  --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans";
+}
+
+html[data-theme="dark"]{
+  --bg: #0e0f10;
+  --surface: #131416;
+  --text: #f6f6f6;
+  --muted: rgba(246,246,246,.64);
+  --line: rgba(246,246,246,.12);
+  --shadow: 0 18px 40px rgba(0,0,0,.55);
+  --shadow-soft: 0 10px 28px rgba(0,0,0,.45);
+  --grad: radial-gradient(1200px 600px at 10% 10%, rgba(255,210,79,.18), rgba(0,0,0,0) 55%),
+          radial-gradient(900px 500px at 92% 18%, rgba(255,178,0,.10), rgba(0,0,0,0) 58%),
+          linear-gradient(180deg, #0c0d0e, #0e0f10 38%, #0e0f10);
+}
+
+*{box-sizing:border-box}
+body{margin:0;background:var(--grad);color:var(--text);font-family:var(--font-sans);letter-spacing:-.01em}
+a{color:inherit;text-decoration:none}
+
+.le-topbar{
+  position:sticky;top:0;z-index:20;
+  backdrop-filter:saturate(180%) blur(14px);
+  background:color-mix(in srgb, var(--bg) 72%, transparent);
+  border-bottom:1px solid var(--line);
+}
+.le-topbar__inner{
+  display:flex;align-items:center;justify-content:space-between;
+  padding:14px 18px;max-width:1100px;margin:0 auto;gap:10px;
+}
+.le-brand{display:flex;align-items:center;gap:10px}
+.le-brand__mark{
+  width:40px;height:40px;border-radius:14px;
+  background:linear-gradient(135deg,var(--yellow-2),var(--yellow-3));
+  box-shadow:0 14px 30px rgba(255,178,0,.28);
+  display:grid;place-items:center;font-weight:800;color:#1a1407;
+}
+.le-brand__name{font-weight:780;font-size:14.5px}
+.le-nav{display:none;gap:14px}
+.le-nav__link{
+  padding:10px 12px;border-radius:999px;color:var(--muted);
+  transition:background .2s ease, color .2s ease;
+}
+.le-nav__link:hover{background:color-mix(in srgb,var(--surface) 78%, transparent);color:var(--text)}
+.le-iconbtn{
+  border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 85%, transparent);
+  width:44px;height:44px;border-radius:16px;display:grid;place-items:center;
+  box-shadow:var(--shadow-soft);cursor:pointer;transition:transform .15s ease;
+}
+.le-iconbtn:active{transform:scale(.97)}
+.le-iconbtn__dot{
+  width:14px;height:14px;border-radius:50%;
+  background:linear-gradient(135deg,var(--yellow-1),var(--yellow-3));
+  box-shadow:0 8px 20px rgba(255,178,0,.35);
+}
+
+.le-main{max-width:1100px;margin:0 auto;padding:18px 18px 44px}
+
+.le-hero{
+  padding:26px 18px;border-radius:28px;
+  background:linear-gradient(135deg, rgba(255,227,106,.85), rgba(255,178,0,.25));
+  border:1px solid rgba(23,23,23,.10);
+  box-shadow:var(--shadow);
+  overflow:hidden;position:relative;
+}
+.le-hero__grid{display:grid;gap:16px}
+.le-hero__title{font-weight:900;font-size:34px;line-height:1.05;margin:0;color:#16110a;letter-spacing:-.03em}
+.le-hero__subtitle{margin:0;color:rgba(22,17,10,.72);font-weight:560}
+.le-chiprow{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
+.le-chip{
+  background:rgba(255,255,255,.65);border:1px solid rgba(23,23,23,.10);
+  padding:8px 10px;border-radius:999px;font-size:12.5px;font-weight:650;
+}
+.le-search{
+  margin-top:16px;display:flex;gap:10px;
+  background:rgba(255,255,255,.72);
+  border:1px solid rgba(23,23,23,.12);
+  border-radius:18px;padding:12px;
+}
+.le-input{
+  width:100%;border:0;background:transparent;outline:none;
+  font-size:14.5px;font-weight:560;color:#171717;
+}
+.le-btn{
+  border:0;cursor:pointer;
+  background:linear-gradient(135deg,var(--yellow-2),var(--yellow-3));
+  color:#1a1407;font-weight:820;font-size:14px;
+  padding:12px 14px;border-radius:14px;
+  box-shadow:0 16px 32px rgba(255,178,0,.28);
+  transition:transform .15s ease, filter .15s ease;
+  white-space:nowrap;
+}
+.le-btn:active{transform:translateY(1px)}
+.le-btn:hover{filter:saturate(1.08)}
+.le-section{margin-top:18px}
+.le-section__head{display:flex;align-items:end;justify-content:space-between;margin:0 0 10px}
+.le-section__title{margin:0;font-size:16px;font-weight:860;letter-spacing:-.02em}
+.le-section__link{font-size:13px;color:var(--muted)}
+.le-rail{display:flex;gap:12px;overflow:auto;padding-bottom:6px;scroll-snap-type:x mandatory}
+.le-card{
+  background:color-mix(in srgb, var(--surface) 92%, transparent);
+  border:1px solid var(--line);border-radius:var(--radius-lg);
+  box-shadow:var(--shadow-soft);
+  min-width:240px;scroll-snap-align:start;
+  transition:transform .16s ease, box-shadow .16s ease;
+}
+.le-card:hover{transform:translateY(-2px)}
+.le-card__body{padding:14px}
+.le-badge{
+  display:inline-flex;align-items:center;gap:6px;
+  padding:6px 10px;border-radius:999px;font-size:12px;font-weight:750;
+  background:rgba(255,227,106,.38);border:1px solid rgba(255,178,0,.35);
+}
+.le-muted{color:var(--muted)}
+.le-grid{display:grid;grid-template-columns:1fr;gap:12px}
+.le-grid2{display:grid;grid-template-columns:1fr;gap:12px}
+.le-stickybar{
+  position:sticky;bottom:12px;z-index:10;
+  background:color-mix(in srgb,var(--surface) 88%, transparent);
+  border:1px solid var(--line);border-radius:18px;
+  box-shadow:var(--shadow);
+  padding:12px;display:flex;gap:10px;align-items:center;justify-content:space-between;
+}
+
+.le-skeleton{
+  background:linear-gradient(90deg, rgba(0,0,0,.06), rgba(0,0,0,.02), rgba(0,0,0,.06));
+  background-size:220% 100%;
+  border-radius:14px;
+  animation:le-shimmer 1.2s ease-in-out infinite;
+}
+html[data-theme="dark"] .le-skeleton{
+  background:linear-gradient(90deg, rgba(255,255,255,.08), rgba(255,255,255,.03), rgba(255,255,255,.08));
+  background-size:220% 100%;
+}
+@keyframes le-shimmer{0%{background-position:0% 0}100%{background-position:200% 0}}
+
+.le-footer{margin-top:26px;border-top:1px solid var(--line);background:color-mix(in srgb,var(--surface) 72%, transparent)}
+.le-footer__inner{max-width:1100px;margin:0 auto;padding:18px}
+.le-footer__cols{display:flex;gap:12px;flex-direction:column}
+.le-footer__title{font-weight:880}
+.le-footer__links{display:flex;flex-wrap:wrap;gap:12px;color:var(--muted);font-size:13px}
+.le-footer__links a:hover{color:var(--text)}
+.le-footer__bottom{margin-top:12px}
+.le-footer__muted{color:var(--muted);font-size:13px}
+
+@media (min-width:760px){
+  .le-nav{display:flex}
+  .le-hero{padding:32px 26px}
+  .le-hero__grid{grid-template-columns:1.3fr .7fr;align-items:end}
+  .le-hero__title{font-size:44px}
+  .le-grid2{grid-template-columns:1fr 1fr}
+  .le-grid{grid-template-columns:repeat(3, 1fr)}
+}
